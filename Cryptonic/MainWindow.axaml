<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cryptonic.MainWindow"
        Title="Cryptonic">
    <Grid>
    <!-- Define rows for the grid -->
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- For the panel -->
        <RowDefinition Height="*"/>  <!-- For the existing content -->
    </Grid.RowDefinitions>

    <!-- New panel for the TextBox and Label -->
    <Grid Name="MainGrid" ColumnDefinitions="Auto,Auto, 8*" Margin="10">

        <Button Width="35" Height="35" Content="&lt;" FontSize="20"
         HorizontalContentAlignment="Center"
         Padding="-0.5"
         VerticalContentAlignment = "Center"
         FontFamily="{StaticResource FiraCodeNerdFont}" 
         Grid.Column="0"/>
        <Button Width="35" Height="35" Content="&gt;" FontSize="20"
         HorizontalContentAlignment="Center"
         Padding="-0.5"
         VerticalContentAlignment = "Center"
         FontFamily="{StaticResource FiraCodeNerdFont}" 
         Grid.Column="1"/>
           <TextBox Name="NavPathTB"  Grid.Column="2">
            </TextBox>
           </Grid>

    <!-- Original Grid with SplitterGrid -->
    <Grid Grid.Row="1" ColumnDefinitions="250,4,*">
        <Border x:Name="NavPane"
                Grid.Column="0"
                >
               
        </Border>

        <GridSplitter Grid.Column="1" Name="MainSplitter"
                      Width="4"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWestEast"/>
    </Grid>
</Grid>


</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cryptonic.MainWindow"
        Title="Cryptonic">
        <Grid>
        <!-- Define two columns with a splitter column in between -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="100"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>
<!-- Splitter -->
<GridSplitter Grid.Column="1" 
              Background="#FFCCCCCC" 
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch"/>
        <!-- Left Pane -->
        <Border Grid.Column="0" Background="#FFF0F0F0" Padding="15">
            <TextBlock Text="Left Pane" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Foreground="Black"/>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" 
                      Background="#FFCCCCCC" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"/>

        <!-- Right Pane -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="White" Padding="15"> <!-- Wait, use Column 2 for right pane -->
        </Border>
        
        <!-- Right Pane (Corrected) -->
        <Border Grid.Column="2" Background="White" Padding="15">
            <TextBlock Text="Right Pane" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Foreground="Black"/>
        </Border>
    </Grid>
</Window>

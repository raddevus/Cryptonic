<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cryptonic.MainWindow"
        xmlns:local="clr-namespace:Cryptonic.Models"

        Title="Cryptonic">


<Grid>
   <Grid.RowDefinitions>
      <RowDefinition Height="*"/> <!-- For the panel -->
      <RowDefinition Height="Auto"/>  <!-- For the existing content -->
   </Grid.RowDefinitions>
        <!-- Define two columns with a splitter column in between -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="100"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <!-- Left Pane -->
        <Border Grid.Column="0" Background="DarkGreen" Padding="15">
        <StackPanel Orientation="Vertical">
            <Label Target="PwdGridLabel" Grid.Row="0" Grid.Column="0" >Draw a pattern</Label>
            <local:PwdGrid Name="PwdGrid" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Width="250" Height="250" Margin="10" />
            <StackPanel Orientation="Horizontal">
            <CheckBox Name="HidePatternCheckBox" Click="SetHidePattern" Grid.Row="0" Grid.Column="0" Margin="5"
            >Hide Pattern</CheckBox>
            <Button Click="ClearHandler" Grid.Row="0" Grid.Column="0" Margin="5">Clear</Button>
            </StackPanel>
             <TextBox Text="{Binding #PwdGrid.GeneratedPassword}" Name="PwdTextBox"  Height="100" AcceptsReturn="True" TextWrapping="Wrap"
            TextChanged="PasswordTextChanged"/>
            </StackPanel>
        </Border>

        <!-- Right Pane -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="White" Padding="15"> <!-- Wait, use Column 2 for right pane -->
        </Border>

                <!-- Splitter -->
        <GridSplitter Grid.Column="1" Name="MainSplitter"
                      Width="4"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWestEast"/>

        
        <!-- Right Pane (Corrected) -->
        <Border Grid.Column="2" Background="White" Padding="15">
            <TextBlock Text="Right Pane" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Foreground="Black"/>
        </Border>
    </Grid>

</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cryptonic.MainWindow"
        Title="Cryptonic">
    <Grid>
    <!-- Define rows for the grid -->
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- For the panel -->
        <RowDefinition Height="*"/>  <!-- For the existing content -->
    </Grid.RowDefinitions>

    <!-- Original Grid with SplitterGrid -->
    <Grid Grid.Row="1" ColumnDefinitions="250,4,*">
        <Border x:Name="NavPane"
                Grid.Column="0"
                >
               
        </Border>

        <GridSplitter Grid.Column="1" Name="MainSplitter"
                      Width="4"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWestEast"/>
    </Grid>
</Grid>


</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Cryptonic.MainWindow"
        xmlns:local="clr-namespace:Cryptonic.Models"

        Title="Cryptonic">
    <Grid>
    <!-- Define rows for the grid -->
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- For the panel -->
        <RowDefinition Height="*"/>  <!-- For the existing content -->
    </Grid.RowDefinitions>

    <!-- Original Grid with SplitterGrid -->
    <Grid Grid.Row="1" ColumnDefinitions="250,4,*">
                <Label Target="PwdGridLabel" Grid.Row="0" Grid.Column="0">2. Draw a pattern</Label>
            <local:PwdGrid Name="PwdGrid" Width="250" Height="250" Grid.Row="1" Grid.Column="0" Grid.RowSpan="4"/>
            <StackPanel Grid.Column="0" Grid.Row="11" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox Name="HidePatternCheckBox" Click="SetHidePattern">Hide Pattern</CheckBox>
              <Button Click="ClearHandler">Clear</Button>
            </StackPanel>
            <TextBox Text="{Binding #PwdGrid.GeneratedPassword}" Name="PwdTextBox" Grid.Row="12" Grid.Column="0" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
            TextChanged="PasswordTextChanged"/>

        <Border x:Name="NavPane"
                Grid.Column="0"
                >
               
        </Border>

        <GridSplitter Grid.Column="1" Name="MainSplitter"
                      Width="4"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWestEast"/>
    </Grid>
</Grid>


</Window>
